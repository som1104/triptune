# ─── 앱 실행 (개발/운영) ─────────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── E2E 테스트 (.env.test 에 넣으세요) ──────────────────────────────
# 자동 테스트는 운영 데이터베이스를 대상으로 실행할 수 없습니다.
# NEXT_PUBLIC_* 를 그대로 재사용하지 않고 아래 값을 따로 받습니다.
#
# 필수
#   E2E_SUPABASE_URL       테스트용 Supabase 주소 (로컬: http://127.0.0.1:54321)
#   E2E_SUPABASE_ANON_KEY  테스트용 anon(publishable) 키
#
# 선택
#   E2E_BASE_URL                    테스트가 붙을 앱 주소 (기본 http://127.0.0.1:3100)
#   E2E_PORT                        테스트용 앱 포트 (기본 3100)
#   E2E_ALLOW_REMOTE_SUPABASE=1     로컬이 아닌 '테스트 전용' Supabase 프로젝트를 쓸 때만
#   E2E_SUPABASE_SERVICE_ROLE_KEY   테스트 데이터 정리 전용. 브라우저로 나가지 않습니다.
#                                   비워두면 정리를 건너뛰고 남은 데이터를 알려줍니다.
#
# E2E_SUPABASE_URL=http://127.0.0.1:54321
# E2E_SUPABASE_ANON_KEY=
# E2E_SUPABASE_SERVICE_ROLE_KEY=
